#!/usr/bin/env python3
"""
tasks.py - a tiny command-line task manager.

Usage:
  python tasks.py add "Buy milk" --priority high --due 2026-10-01
  python tasks.py list [--all] [--sort priority|due|created]
  python tasks.py done 3
  python tasks.py undo 3
  python tasks.py delete 3
  python tasks.py stats
  python tasks.py clear-done
"""
import argparse
import json
import os
import sys
from datetime import date, datetime

DB_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tasks.json")
PRIORITIES = {"low": 1, "medium": 2, "high": 3}
COLORS = {"low": "\033[36m", "medium": "\033[33m", "high": "\033[31m"}
RESET, DIM, GREEN = "\033[0m", "\033[2m", "\033[32m"


# ---------- storage ----------
def load():
    if not os.path.exists(DB_FILE):
        return {"next_id": 1, "tasks": []}
    try:
        with open(DB_FILE) as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError):
        print("warning: tasks.json is corrupt, starting fresh", file=sys.stderr)
        return {"next_id": 1, "tasks": []}


def save(db):
    tmp = DB_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(db, f, indent=2)
    os.replace(tmp, DB_FILE)  # atomic write so a crash can't wipe the file


def find(db, task_id):
    for t in db["tasks"]:
        if t["id"] == task_id:
            return t
    sys.exit(f"no task with id {task_id}")


# ---------- helpers ----------
def parse_due(s):
    if s is None:
        return None
    try:
        return datetime.strptime(s, "%Y-%m-%d").date().isoformat()
    except ValueError:
        sys.exit("due date must look like YYYY-MM-DD")


def due_label(due):
    if not due:
        return ""
    days = (date.fromisoformat(due) - date.today()).days
    if days < 0:
        return f"\033[31moverdue {-days}d{RESET}"
    if days == 0:
        return "\033[33mdue today\033[0m"
    return f"{DIM}due in {days}d{RESET}"


def fmt(t):
    box = f"{GREEN}[x]{RESET}" if t["done"] else "[ ]"
    pri = f"{COLORS[t['priority']]}{t['priority']:<6}{RESET}"
    title = f"{DIM}{t['title']}{RESET}" if t["done"] else t["title"]
    return f"{t['id']:>3} {box} {pri} {title}  {due_label(t['due'])}"


# ---------- commands ----------
def cmd_add(db, args):
    task = {
        "id": db["next_id"],
        "title": args.title.strip(),
        "priority": args.priority,
        "due": parse_due(args.due),
        "done": False,
        "created": datetime.now().isoformat(timespec="seconds"),
    }
    if not task["title"]:
        sys.exit("title can't be empty")
    db["tasks"].append(task)
    db["next_id"] += 1
    save(db)
    print(f"added #{task['id']}: {task['title']}")


def cmd_list(db, args):
    tasks = db["tasks"] if args.all else [t for t in db["tasks"] if not t["done"]]
    if not tasks:
        print("nothing here. go touch grass.")
        return
    keys = {
        "priority": lambda t: -PRIORITIES[t["priority"]],
        "due": lambda t: t["due"] or "9999-12-31",
        "created": lambda t: t["created"],
    }
    for t in sorted(tasks, key=keys[args.sort]):
        print(fmt(t))


def cmd_set_done(db, args, value):
    t = find(db, args.id)
    t["done"] = value
    save(db)
    print(f"#{t['id']} marked {'done' if value else 'not done'}")


def cmd_delete(db, args):
    t = find(db, args.id)
    db["tasks"].remove(t)
    save(db)
    print(f"deleted #{t['id']}: {t['title']}")


def cmd_clear_done(db, _args):
    before = len(db["tasks"])
    db["tasks"] = [t for t in db["tasks"] if not t["done"]]
    save(db)
    print(f"removed {before - len(db['tasks'])} finished task(s)")


def cmd_stats(db, _args):
    tasks = db["tasks"]
    if not tasks:
        print("no tasks yet")
        return
    done = sum(t["done"] for t in tasks)
    overdue = sum(
        1 for t in tasks
        if not t["done"] and t["due"] and date.fromisoformat(t["due"]) < date.today()
    )
    pct = done / len(tasks) * 100
    bar = "#" * int(pct // 5) + "-" * (20 - int(pct // 5))
    print(f"total:   {len(tasks)}")
    print(f"done:    {done}  [{bar}] {pct:.0f}%")
    print(f"open:    {len(tasks) - done}")
    print(f"overdue: {overdue}")
    for p in PRIORITIES:
        n = sum(1 for t in tasks if t["priority"] == p and not t["done"])
        print(f"  open {p:<6} {n}")


# ---------- CLI ----------
def main():
    p = argparse.ArgumentParser(description="tiny task manager")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add")
    a.add_argument("title")
    a.add_argument("--priority", choices=PRIORITIES, default="medium")
    a.add_argument("--due", help="YYYY-MM-DD")

    l = sub.add_parser("list")
    l.add_argument("--all", action="store_true", help="include finished tasks")
    l.add_argument("--sort", choices=["priority", "due", "created"], default="priority")

    for name in ("done", "undo", "delete"):
        s = sub.add_parser(name)
        s.add_argument("id", type=int)

    sub.add_parser("stats")
    sub.add_parser("clear-done")

    args = p.parse_args()
    db = load()
    {
        "add": cmd_add,
        "list": cmd_list,
        "done": lambda d, a: cmd_set_done(d, a, True),
        "undo": lambda d, a: cmd_set_done(d, a, False),
        "delete": cmd_delete,
        "stats": cmd_stats,
        "clear-done": cmd_clear_done,
    }[args.cmd](db, args)


if __name__ == "__main__":
    main()
